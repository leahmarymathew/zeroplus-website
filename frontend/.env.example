# API
# Base URL of the backend REST API (Section 6.1). Points at the mock layer
# locally until /backend exists; NEXT_PUBLIC_USE_MOCKS controls that switch.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/v1
NEXT_PUBLIC_USE_MOCKS=true

# Google Sign-In (Section 1 — @react-oauth/google)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Store contact (footer / WhatsApp FAB — Section 2.1)
NEXT_PUBLIC_WHATSAPP_NUMBER=919800000000
