# Database (Neon connection string; local Postgres fine for dev)
DATABASE_URL=

# Auth
JWT_SECRET=
JWT_REFRESH_SECRET=

# Google OAuth (same client ID the frontend uses — plan Section 1)
GOOGLE_CLIENT_ID=

# PhonePe (UAT sandbox creds in dev, live creds in prod — plan Section 11)
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
PHONEPE_BASE_URL=https://api-preprod.phonepe.com/apis/pg-sandbox

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend
RESEND_API_KEY=
EMAIL_FROM=Zeroplus <orders@yourdomain.example>

# OTP — "console" (dev: codes print to server log) or "whatsapp" (Meta Cloud API)
# WhatsApp Business Platform replaces MSG91/SMS — no TRAI DLT registration required.
OTP_PROVIDER=console
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_OTP_TEMPLATE=otp_verification
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_API_VERSION=v21.0

# Seed (first admin account — created by `npm run seed`, never via an endpoint)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PHONE=
SEED_ADMIN_PASSWORD=

# App
PORT=4000
FRONTEND_URL=http://localhost:3000
# Public URL of this backend (tunnel URL locally) — PhonePe webhook target
BACKEND_PUBLIC_URL=http://localhost:4000
NODE_ENV=development
